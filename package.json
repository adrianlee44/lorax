{
  "name": "lorax",
  "version": "3.0.0",
  "description": "A node module which reads the git log and create a human readable changelog",
  "exports": "./lib/lorax.js",
  "bin": {
    "lorax": "bin/lorax"
  },
  "files": [
    "bin/lorax",
    "build/**/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "test": "npm run clean; npm run lint; tsc -p tsconfig.build.json; npm run coverage",
    "jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "coverage": "npm run jest -- --coverage",
    "report": "npm run jest -- --coverage --coverageReporters=lcov",
    "clean": "rm -rf coverage/ build/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianlee44/lorax.git"
  },
  "keywords": [
    "log",
    "changelog",
    "generator",
    "git",
    "markdown"
  ],
  "author": {
    "name": "Adrian Lee",
    "email": "208855+adrianlee44@users.noreply.github.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adrianlee44/lorax/issues"
  },
  "homepage": "https://github.com/adrianlee44/lorax",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.1.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "commander": "^11.1.0"
  }
}